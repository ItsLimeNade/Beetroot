DISCORD_TOKEN=<TOKEN>
BOT_VERSION=<VERSION>
DATABASE_URL=sqlite:///<PATH>
# Secret feeding token-encryption key derivation. Use a long (32+ char) random,
# secret value. The bot refuses to start if this is unset/blank/placeholder.
# Rotating this value invalidates all stored tokens (users must re-run /setup).
# Legacy name ENCRYPTION_SALT is still accepted for backward compatibility.
ENCRYPTION_KEY=<32+ RANDOM SECRET CHARS>
DISCORD_CLIENT_ID=<CLIENT ID>
DISCORD_CLIENT_SECRET=<CLIENT SECRET>
DISCORD_REDIRECT_URI=<REIRECT URI>

# --- Logging (all optional, sensible defaults shown) ---
# Standard tracing filter. Default if unset: info,bot=debug,beetroot_core=debug
RUST_LOG=<LOG LEVEL>
# Console format: pretty (default) | compact | full | json
LOG_FORMAT=pretty
# Write rolling daily log files (survive crashes/redeploys). true (default) | false
LOG_FILE=true
# Directory for log files. Put it on the persistent volume, e.g. /app/data/logs
LOG_DIR=/app/data/logs
# Log Discord identifiers AND raw medical-data debug dumps. NEVER enable in
# production. false (default) | true
LOG_SENSITIVE=false

FOOD_CLIENT_ID=<CLIENT ID>
FOOD_CLIENT_SECRET=<CLIENT SECRET>